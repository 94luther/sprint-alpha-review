PORT=4000
WEB_ORIGIN=http://localhost:5173

# HS256 secret used to sign login tokens. Any random string works for the demo.
JWT_SECRET=replace_with_a_long_random_string

# AES-256-GCM key, 64 hex characters (32 bytes). Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEMO_MASTER_KEY=replace_with_64_hex_characters

# Multiplies how fast the order lifecycle simulator moves. 1 = real pace (6 to 10s per step).
# 2 = twice as fast, 0.5 = half speed. Handy for a quick demo run through.
DEMO_SPEED=1
